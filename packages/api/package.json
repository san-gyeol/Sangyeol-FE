{
  "name": "api",
  "packageManager": "yarn@4.9.4",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup --clean",
    "build:docs": "docflow build && yarn docs:generate-index",
    "check:docs": "docflow check",
    "docs:generate-index": "node scripts/generate-docs-index.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "docflow": "^0.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  }
}
